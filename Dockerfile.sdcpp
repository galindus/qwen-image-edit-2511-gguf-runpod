# Model stage deliberately precedes the application image.  Docker caches this
# independently, so touching handler_sdcpp.py, the runtime dependencies, or
# the final base image does not make the ~20 GB model download run again.
FROM debian:bookworm-slim AS model-download

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      aria2 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY download_sdcpp_models.sh /usr/local/bin/download_sdcpp_models
RUN chmod +x /usr/local/bin/download_sdcpp_models

# One model per cached layer. A build interruption after a completed model
# retains its layer and retries only the outstanding file on the next build.
RUN MODEL_ROOT=/opt/models /usr/local/bin/download_sdcpp_models transformer
RUN MODEL_ROOT=/opt/models /usr/local/bin/download_sdcpp_models encoder
RUN MODEL_ROOT=/opt/models /usr/local/bin/download_sdcpp_models mmproj
RUN MODEL_ROOT=/opt/models /usr/local/bin/download_sdcpp_models vae
RUN MODEL_ROOT=/opt/models /usr/local/bin/download_sdcpp_models lora
RUN find /opt/models -type f -printf '%p %s bytes\\n'

# Official precompiled CUDA runner.  `master-cuda` contains sd-cli and
# sd-server built by stable-diffusion.cpp's own CI, so this endpoint does not
# compile C++ during a Runpod build.
FROM ghcr.io/leejet/stable-diffusion.cpp:master-cuda

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-pip \
 && python3 -m pip install --break-system-packages --no-cache-dir runpod requests pillow \
 && rm -rf /var/lib/apt/lists/*

COPY --from=model-download /opt/models /opt/models

# Keep this COPY after the model layer.  Handler-only changes now reuse all
# model download layers in a cached Docker build.
COPY handler_sdcpp.py /app/handler.py

# Models are baked into the image so the endpoint can be deployed in any
# Serverless region without a network volume. Override MODEL_ROOT only for a
# deliberate external-model experiment.
ENV MODEL_ROOT=/opt/models \
    SDC_PORT=8188 \
    SDC_STEPS=4 \
    SDC_CFG=1.0 \
    SDC_MAX_SIDE=1536 \
    SDC_MEMORY_MODE=clip_cpu \
    SDC_TRANSFORMER=qwen-image-edit-2511-Q4_K_M.gguf \
    SDC_TEXT_ENCODER=Qwen2.5-VL-7B-Instruct-UD-Q4_K_XL.gguf \
    SDC_MMPROJ=Qwen2.5-VL-7B-Instruct-mmproj-BF16.gguf \
    SDC_VAE=qwen_image_vae.safetensors \
    SDC_LORA=Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors

WORKDIR /app
# The upstream image declares ENTRYPOINT /sd-cli.  Override it: this image is
# a Runpod worker, not an interactive stable-diffusion.cpp CLI container.
ENTRYPOINT ["python3", "-u", "/app/handler.py"]
