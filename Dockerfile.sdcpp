# Official precompiled CUDA runner.  `master-cuda` contains sd-cli and
# sd-server built by stable-diffusion.cpp's own CI, so this endpoint does not
# compile C++ during a Runpod build.
FROM ghcr.io/leejet/stable-diffusion.cpp:master-cuda

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-pip \
 && python3 -m pip install --break-system-packages --no-cache-dir runpod requests pillow \
 && rm -rf /var/lib/apt/lists/*

COPY handler_sdcpp.py /app/handler.py

# Files live in the network volume, shared with the existing endpoint.
# Override these paths with endpoint environment variables only if needed.
ENV MODEL_ROOT=/runpod-volume/models \
    SDC_PORT=8188 \
    SDC_STEPS=4 \
    SDC_CFG=1.0 \
    SDC_MAX_SIDE=1536 \
    SDC_TRANSFORMER=qwen-image-edit-2511-Q4_K_M.gguf \
    SDC_TEXT_ENCODER=Qwen2.5-VL-7B-Instruct-UD-Q4_K_XL.gguf \
    SDC_MMPROJ=Qwen2.5-VL-7B-Instruct-mmproj-BF16.gguf \
    SDC_VAE=qwen_image_vae.safetensors \
    SDC_LORA=Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors

WORKDIR /app
# The upstream image declares ENTRYPOINT /sd-cli.  Override it: this image is
# a Runpod worker, not an interactive stable-diffusion.cpp CLI container.
ENTRYPOINT ["python3", "-u", "/app/handler.py"]
